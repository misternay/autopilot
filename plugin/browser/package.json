{
  "name": "@ramenvr/autopilot-browser",
  "version": "0.1.0",
  "description": "Autopilot browser/TypeScript plugin — connects a PixiJS (or any JS) game to the Autopilot brain",
  "type": "module",
  "main": "./dist/index.js",
